# Settings for this backend. Copy to .env and fill in. Never commit .env.
# Every value here is an example or empty on purpose — no secret is part of the code.

# Required: a long random value that signs sign-in tokens. Make one with:  openssl rand -base64 48
JWT_SECRET=

# Postgres. docker-compose.yml builds DATABASE_URL from the three POSTGRES_* values.
# Use letters and digits in the password (it becomes part of a URL).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
# Only when running without docker compose, e.g.: postgres://app:<password>@localhost:5432/app
DATABASE_URL=

PORT=8787
# The web addresses your app runs on, comma-separated (CORS). Empty = browsers on other sites can't call it.
ALLOWED_ORIGINS=

# Sign-in
SIGNUP=open
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
PASSWORD_ITERATIONS=600000
# The page of your app that finishes a sign-in link (the token is added as ?token=...). Empty = links are off.
MAGIC_LINK_URL=
MAGIC_LINK_TTL=900
# console (prints the email; for your own machine) or webhook (POSTs it as JSON to your mail relay)
MAILER=console
MAILER_WEBHOOK_URL=
MAILER_WEBHOOK_TOKEN=

# Who may use shared collections: signed-in (default), public-read (anyone reads, writing needs sign-in)
# or anyone (an app with no sign-in: anyone who can reach this server reads and writes them)
SHARED_ACCESS=signed-in

# Requests per minute per client
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# true only behind your own reverse proxy (then X-Forwarded-For is trusted)
TRUST_PROXY=false

# Migrations run at start; set false to run them yourself with: npm run migrate
MIGRATE_ON_START=true
ALLOW_DESTRUCTIVE_MIGRATIONS=false
