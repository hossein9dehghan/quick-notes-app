{
  "name": "quick-notes-app-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The backend of this app: Hono + Postgres, generated by Duxner Maker.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file=.env --watch src/index.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "import": "node --env-file-if-exists=.env scripts/import.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3"
  }
}
